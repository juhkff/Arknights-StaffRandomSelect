<Window
    x:Class="StaffRandomSelect.StaffPickDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="选择干员"
    Width="360"
    Height="420"
    MinHeight="320"
    WindowStartupLocation="CenterOwner"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{materialDesign:MaterialDesignFont}"
    TextElement.FontSize="14"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    mc:Ignorable="d">
    <Window.Resources>
        <Style
            x:Key="StaffPickListBoxItem"
            BasedOn="{StaticResource MaterialDesignListBoxItem}"
            TargetType="{x:Type ListBoxItem}">
            <Setter Property="Padding" Value="10,8" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueMidBrush}" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True" />
                        <Condition Property="IsMouseOver" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}" />
                </MultiTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBox
                x:Name="SearchBox"
                materialDesign:HintAssist.Hint="输入名称筛选"
                FontFamily="Microsoft YaHei"
                Style="{StaticResource MaterialDesignOutlinedTextBox}"
                TextChanged="SearchBox_TextChanged" />
            <TextBlock
                Margin="0,6,0,0"
                FontFamily="Microsoft YaHei"
                FontSize="12"
                Foreground="{DynamicResource MaterialDesignBody}"
                Opacity="0.65"
                Text="提示：点击条目即可多选或取消选中；已选项左侧有紫色条与底色区分。"
                TextWrapping="Wrap" />
        </StackPanel>
        <ListBox
            x:Name="StaffList"
            Grid.Row="1"
            Margin="0,0,0,12"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="1"
            DisplayMemberPath="Name"
            FontFamily="Microsoft YaHei"
            ItemContainerStyle="{StaticResource StaffPickListBoxItem}"
            KeyDown="StaffList_KeyDown"
            MouseDoubleClick="StaffList_MouseDoubleClick"
            SelectionMode="Multiple" />
        <StackPanel
            Grid.Row="2"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <Button
                Margin="0,0,8,0"
                Click="Ok_Click"
                Content="确定"
                Cursor="Hand"
                FontFamily="Microsoft YaHei"
                IsDefault="True"
                Style="{StaticResource MaterialDesignRaisedButton}" />
            <Button
                Click="Cancel_Click"
                Content="取消"
                Cursor="Hand"
                FontFamily="Microsoft YaHei"
                IsCancel="True"
                Style="{StaticResource MaterialDesignFlatButton}" />
        </StackPanel>
    </Grid>
</Window>
