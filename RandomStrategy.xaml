<ContentControl
    x:Class="StaffRandomSelect.RandomStrategy"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:domain="clr-namespace:StaffRandomSelect.Domain"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Background="{DynamicResource MaterialDesignPaper}"
    FontFamily="{materialDesign:MaterialDesignFont}"
    TextElement.FontSize="14"
    TextElement.FontWeight="Medium"
    TextElement.Foreground="{DynamicResource MaterialDesignBody}"
    mc:Ignorable="d">

    <DockPanel Margin="0,8,0,0" LastChildFill="True">
        <Grid Margin="0,0,0,12" DockPanel.Dock="Top">
            <TextBlock
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontFamily="Microsoft YaHei"
                FontSize="18"
                FontWeight="Bold"
                Text="随机策略" />
            <Button
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Click="AddStrategy_Click"
                Content="添加"
                Cursor="Hand"
                FontFamily="Microsoft YaHei"
                Style="{StaticResource MaterialDesignRaisedButton}" />
        </Grid>

        <ScrollViewer
            VerticalScrollBarVisibility="Auto"
            DockPanel.Dock="Top">
            <ItemsControl x:Name="StrategyItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type domain:RandomStrategyDefinition}">
                        <Border
                            Margin="0,0,0,12"
                            Padding="12"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="1"
                            CornerRadius="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,8">
                                    <TextBlock
                                        FontFamily="Microsoft YaHei"
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Text="{Binding Name}" />
                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,4,0"
                                            Click="EditStrategy_Click"
                                            Content="编辑"
                                            Cursor="Hand"
                                            FontFamily="Microsoft YaHei"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Tag="{Binding}" />
                                        <Button
                                            Click="DeleteStrategy_Click"
                                            Content="删除"
                                            Cursor="Hand"
                                            FontFamily="Microsoft YaHei"
                                            Foreground="#c62828"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Tag="{Binding}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,0,0,8"
                                    FontFamily="Microsoft YaHei"
                                    Foreground="Gray"
                                    Text="条目：" />
                                <ItemsControl Grid.Row="2" ItemsSource="{Binding Rules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type domain:StrategyRule}">
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontFamily="Microsoft YaHei"
                                                Text="{Binding SummaryLine}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</ContentControl>
